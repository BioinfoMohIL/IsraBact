output_name="results"
is_tree="false"


diphtoscan \
-a /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/CB521_filtered_contigs.fasta /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/CB522_filtered_contigs.fasta /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/CB527_filtered_contigs.fasta /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/CB530_filtered_contigs.fasta /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/CB537_filtered_contigs.fasta /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/CB534_filtered_contigs.fasta \
-st \
-t \
-res_vir \
 \
-integron \
 \
-o ${output_name} \
--threads 16 

if [[ -d results && "$(ls -A results)" ]]; then
    zip -r results.zip results
fi

# Run this block only if tree = true
    if [[ "${is_tree}" == "true" ]]; then
        mkdir -p jolytree_results
        echo "Gathering tree results ..."
        mv *jolytree.* jolytree_results/ 2>/dev/null

        if [[ -d jolytree_results && "$(ls -A jolytree_results)" ]]; then
            zip -r jolytree_results.zip jolytree_results
        fi
    fi
