
# date and version control
date | tee DATE
trimmomatic -version > VERSION && sed -i -e 's/^/Trimmomatic /' VERSION

CROPPING_VAR=""
# if trimmomatic base chop is defined (-n means not empty), determine average readlength of the input reads
if [ -n "" ]; then
  # determine the average read length of the input reads
  read_length_r1=$(zcat /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/NM271_R1.fastq.gz | awk '{if(NR%4==2) {bases+=length($0)} } END {print bases/(NR/4)}')
  read_length_r2=$(zcat /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/NM271_R2.fastq.gz | awk '{if(NR%4==2) {bases+=length($0)} } END {print bases/(NR/4)}')

  # take the average of the two read lengths without using bc and remove the end base chop
  avg_readlength=$(python3 -c "print(int(((${read_length_r1} + ${read_length_r2}) / 2) - ))")
    
  # HEADCROP: number of bases to remove from the start of the read
  # CROP: number of bases to KEEP, from the start of the read
  CROPPING_VAR="HEADCROP: CROP:$avg_readlength"
fi
    
trimmomatic PE \
-phred33 \
-threads 4 \
/mnt/miniwdl_task_container/work/_miniwdl_inputs/0/NM271_R1.fastq.gz /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/NM271_R2.fastq.gz \
-baseout NM271.fastq.gz \
"${CROPPING_VAR}" \
SLIDINGWINDOW:10:20 \
MINLEN:75 &> NM271.trim.stats.txt

  