
set -euo pipefail

mob_recon --version | tee VERSION

mkdir -p SH033793_results

# mob_recon echoue (exit != 0) sur certains assemblages degueres (pas de plasmide,
# contigs trop courts, etc.) : on capture le code retour pour ne pas casser
# tout le workflow sur un seul sample defaillant.
set +e
mob_recon \
  --infile /mnt/miniwdl_task_container/work/_miniwdl_inputs/0/SH033793_filtered_contigs.fasta \
  --outdir SH033793_results \
  --sample_id SH033793 \
  --num_threads 4 \
  --mash_genome_neighbor_threshold 0.002000 \
  --max_contig_size 450000 \
  --max_plasmid_size 450000 \
  --min_rep_evalue 0.000010 \
  --min_mob_evalue 0.000010 \
  --min_con_evalue 0.000010 \
  --min_rpp_evalue 0.000010 \
  --min_length 1000 \
  --min_rep_ident 80 \
  --min_mob_ident 80 \
  --min_con_ident 80 \
  --min_rpp_ident 80 \
  --min_rep_cov 80 \
  --min_mob_cov 80 \
  --min_con_cov 60 \
  --min_rpp_cov 80 \
  --min_overlap 10 \
  --primary_cluster_dist 0.060000 \
  --secondary_cluster_dist 0.025000 \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
   \
  --force
MOB_EXIT=$?
set -e

# Normalise les noms de sortie attendus meme si mob_recon a echoue avant
# de tout generer, pour que les outputs WDL restent valides (fichiers vides).
touch SH033793_results/contig_report.txt
touch SH033793_results/mobtyper_results.txt
touch SH033793_results/mge.report.txt
touch SH033793_results/chromosome.fasta
# biomarkers.blast.txt n'est PAS touch ici : mob_recon ne l'ecrit que si des
# biomarqueurs plasmidiques sont detectes (sinon il ne le cree jamais). On
# laisse donc son absence refleter un vrai "0 biomarqueur" plutot qu'un
# fichier vide artificiel.

# Nombre de plasmides detectes = nombre de fichiers plasmid_*.fasta
PLASMID_COUNT=$(ls SH033793_results/plasmid_*.fasta 2>/dev/null | wc -l || true)
echo "$PLASMID_COUNT" > PLASMID_COUNT

# Regroupe tous les fasta de plasmides en une seule archive tar, meme si vide
tar -czf SH033793_plasmids.tar.gz -C SH033793_results $(cd SH033793_results && ls plasmid_*.fasta 2>/dev/null) 2>/dev/null || tar -czf SH033793_plasmids.tar.gz --files-from=/dev/null

if [ "$MOB_EXIT" -eq 0 ]; then
  echo "SUCCESS" > MOB_RECON_STATUS
else
  echo "FAILED" > MOB_RECON_STATUS
  echo "mob_recon a retourne un code d'erreur (SH033793): $MOB_EXIT" >&2
fi
  